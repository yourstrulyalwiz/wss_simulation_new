modules = ["nodejs-20", "python-3.12", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "zlib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/index.ts"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["npx", "tsx", "server/index.ts"]
build = ["sh", "-c", "npm ci && npm --prefix frontend ci && npm --prefix frontend run build"]

[userenv]

[userenv.shared]
WSS_PUBLIC_READ_ONLY = "false"
WSS_AUTH_PROVIDER = "replit"
WSS_ADMIN_SUBJECTS = "replit:60478077,replit:66881935"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000
